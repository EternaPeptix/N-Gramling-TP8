# EXAMPLE — copy to .env and fill in <...> placeholders.
# .env is gitignored; never commit the real file.
#
# Inkling-2-Small (594B/17B MoE, mixed NVFP4+MXFP8) TP=4 across
# 4x DGX Spark (GB10, 121 GiB unified memory each), switchless RoCE ring.

# --- cluster ---
MASTER_ADDR=<head-ip>          # rank 0 node, e.g. 10.100.227.10 or LAN ip
MASTER_PORT=29500
# rank -> node mapping is positional in launch/inkling2-tp4.sh:
#   rank 0 = head (API), ranks 1..3 = workers, launch workers first.
RANK0_HOST=<head-ip>
RANK1_HOST=<worker1-ip>
RANK2_HOST=<worker2-ip>
RANK3_HOST=<worker3-ip>
VLLM_HOST_IP=<this-node-ip>    # set per node to its own fabric ip

# --- RoCE / NCCL ---
# Single-HCA exact match. Do NOT dual-pin here: the dual-rail pin + expert
# parallel combination cost a rig-day on the qwen38fn lane (all-to-all
# splitting across rails wedges under EP). NCCL_IB_AUTO_DETECT=0 is set by
# the launcher.
NCCL_IB_HCA=rocep1s0f0
NCCL_SOCKET_IFNAME=enp1s0f0np0
NCCL_IB_GID_INDEX=3
NCCL_DEBUG=WARN

# --- model / image ---
MODEL=thinkingmachines/Inkling-2-Small
SERVED_MODEL_NAME=inkling-2-small
INKLING_IMAGE=vllm/vllm-openai:inkling-2-small
HF_CACHE=/home/<user>/.cache/huggingface
VLLM_PORT=8000

# --- memory / context ---
# Weights land ~370-390 GB across the ring; everything else is KV headroom.
# 262144 is the recipe default and the right cap at GMU 0.85.
# 524288 works at GMU 0.90, concurrency 1. 1048576 does NOT fit (64.5 GiB KV).
GMU=0.85
MAXLEN=262144
SEQS=4
MAX_BATCHED=8192
KV_DTYPE=auto          # auto = bf16 KV; fp8 halves the global-layer KV term

# --- features ---
DSPARK=1               # 1 => bundled DSpark speculator, k=7, probabilistic
REASONING=1            # 1 => --reasoning-parser inkling (thinking split)
TOOLS=0                # 1 => --tool-call-parser inkling --enable-auto-tool-choice
MM_LIMIT=2             # images per prompt; the ViT shares ring memory

# --- misc ---
VLLM_EXTRA=            # extra args appended to vllm serve
NCCL_EXTRA=            # extra "-e K=V" docker env pairs
