+// =========================================================================
+// Wave-V16 Direct-Indexed BN=64 Async KV Tile Issuers (Global S_MODE==2)
+//   - Aligned BS==256 fast path: ONE scalar __ldg(bt_row + (n0 >> 8)) per 64-token tile!
+//   - Zero shared KV_blk_slot dependency -> enables 3-slot rotating cp.async ring
+//     with 2 full 16 KiB KV tiles continuously in flight across 256-token page boundaries!
+//   - Strict L2::evict_first cache hint on streaming 1M KV blocks (preserves Q/OP/LP in L2!).
+// =========================================================================
+static __device__ __forceinline__ void issue_kv64_swiz_direct_v16_async(
+    const uint16_t* __restrict__ KV_base,
+    int64_t stride_b, int64_t stride_s,
+    const int32_t* __restrict__ bt_row,
+    int n0_tile, int s_end_live, int BS, int BS_shift,
+    uint32_t kv_sptr,
+    uint4* __restrict__ smem_kv4,
+    bool evict_first,
+    uint64_t l2_policy,
+    int tid
+) {
+    const bool fast_aligned = (BS == 256) && ((n0_tile & 63) == 0) && (n0_tile + 64 <= s_end_live);
+    if (fast_aligned) {
+        const int32_t pblk = __ldg(bt_row + (n0_tile >> 8));
+        const int slot0 = n0_tile & 255;
+        const int64_t blk_base = static_cast<int64_t>(pblk) * stride_b;
+        #pragma unroll
+        for (int i = 0; i < 8; ++i) {
+            const int idx = i * 128 + tid;
+            const int row = idx >> 4;
+            const int c = idx & 15;
+            const int swiz_c = c ^ (row & 7);
+            const int64_t roff = blk_base + static_cast<int64_t>(slot0 + row) * stride_s;
+            const uint32_t s_addr = kv_sptr + static_cast<uint32_t>(row * 256 + swiz_c * 16);
+            if (evict_first) {
+                cp_async_cg_16_evict_first(s_addr, KV_base + roff + c * 8, l2_policy);
+            } else {
+                cp_async_cg_16(s_addr, KV_base + roff + c * 8);
+            }
+        }
+    } else {
+        #pragma unroll
+        for (int i = 0; i < 8; ++i) {
+            const int idx = i * 128 + tid;
+            const int row = idx >> 4;
+            const int c = idx & 15;
+            const int swiz_c = c ^ (row & 7);
+            const int kpos = n0_tile + row;
+            if (kpos < s_end_live) {
+                const int lblk = (BS_shift >= 0) ? (kpos >> BS_shift) : (kpos / BS);
+                const int slot = (BS_shift >= 0) ? (kpos & ((1 << BS_shift) - 1)) : (kpos % BS);
+                const int32_t pblk = __ldg(bt_row + lblk);
+                const int64_t roff = static_cast<int64_t>(pblk) * stride_b + static_cast<int64_t>(slot) * stride_s;
+                const uint32_t s_addr = kv_sptr + static_cast<uint32_t>(row * 256 + swiz_c * 16);
+                if (evict_first) {
+                    cp_async_cg_16_evict_first(s_addr, KV_base + roff + c * 8, l2_policy);
+                } else {
+                    cp_async_cg_16(s_addr, KV_base + roff + c * 8);
+                }
+            } else {
+                smem_kv4[row * 16 + swiz_c] = make_uint4(0u, 0u, 0u, 0u);
+            }
+        }
+    }
+}
