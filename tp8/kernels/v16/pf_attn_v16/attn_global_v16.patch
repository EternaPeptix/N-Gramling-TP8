+template <bool KV_BF12>
+static __device__ __forceinline__ void issue_kv64_direct_v16_async(
+    const uint16_t* __restrict__ KV_base,
+    const uint8_t*  __restrict__ KV_bf12_base,
+    int64_t stride_b, int64_t stride_s,
+    const int32_t* __restrict__ bt_row,
+    int n0_tile, int s_end_live, int BS, int BS_shift,
+    uint32_t kv_sptr,
+    uint4* __restrict__ smem_kv4,
+    bool evict_first,
+    uint64_t l2_policy,
+    int tid
+) {
+    if constexpr (KV_BF12) {
+        (void)KV_base; (void)stride_s;
+        kv_bf12_issue_tile64_direct_v16_async(
+            KV_bf12_base, stride_b, bt_row, n0_tile, s_end_live, BS, BS_shift,
+            kv_sptr, reinterpret_cast<uint8_t*>(smem_kv4), evict_first, l2_policy, tid
+        );
+    } else {
+        (void)KV_bf12_base;
+        issue_kv64_swiz_direct_v16_async(
+            KV_base, stride_b, stride_s, bt_row, n0_tile, s_end_live, BS, BS_shift,
+            kv_sptr, smem_kv4, evict_first, l2_policy, tid
+        );
+    }
+}
