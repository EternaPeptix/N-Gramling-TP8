+static __device__ __forceinline__ void kv_bf12_issue_tile64_direct_v16_async(
+    const uint8_t* __restrict__ kv_half_base,
+    int64_t blk_stride_bytes,
+    const int32_t* __restrict__ bt_row,
+    int n0_tile, int s_end_live, int BS, int BS_shift,
+    uint32_t kv_sptr,
+    uint8_t* __restrict__ smem_kv_u8,
+    bool use_l2_hint,
+    uint64_t l2_policy,
+    int tid
+) {
+    const bool fast_aligned = (BS == 256) && ((n0_tile & 63) == 0) && (n0_tile + 64 <= s_end_live);
+    if (fast_aligned) {
+        const int32_t pblk = __ldg(bt_row + (n0_tile >> 8));
+        const int slot0 = n0_tile & 255;
+        const KvBf12HalfBlock* blk = kv_bf12_half_blk_const(kv_half_base, blk_stride_bytes, pblk);
+        #pragma unroll
+        for (int i = 0; i < 4; ++i) {
+            const int idx = i * 128 + tid;
+            const int row = idx >> 3;
+            const int c   = idx & 7;
+            const int swiz_c = kv_bf12_sm_stage_chunk(row, c);
+            const uint32_t s_addr = kv_sptr + static_cast<uint32_t>(KV_BF12_SM_OFF_B + row * 128 + swiz_c * 16);
+            const void* g_ptr = &blk->sm[slot0 + row][c * 16];
+            if (use_l2_hint) kv_bf12_cp_async_cg_16_l2_hint(s_addr, g_ptr, l2_policy);
+            else             kv_bf12_cp_async_cg_16(s_addr, g_ptr);
+        }
+        #pragma unroll
+        for (int i = 0; i < 2; ++i) {
+            const int idx = i * 128 + tid;
+            const int row = idx >> 2;
+            const int c   = idx & 3;
+            const int swiz_c = kv_bf12_e4_stage_chunk(row, c);
+            const uint32_t s_addr = kv_sptr + static_cast<uint32_t>(KV_BF12_E4_OFF_B + row * 64 + swiz_c * 16);
+            const void* g_ptr = &blk->e4[slot0 + row][c * 16];
+            if (use_l2_hint) kv_bf12_cp_async_cg_16_l2_hint(s_addr, g_ptr, l2_policy);
+            else             kv_bf12_cp_async_cg_16(s_addr, g_ptr);
+        }
+        if (tid < KV_BF12_TILE_BN) {
+            reinterpret_cast<int32_t*>(smem_kv_u8 + KV_BF12_BLKID_OFF_B)[tid] = pblk;
+        }
+        if (tid < (KV_BF12_TILE_BN >> 2)) {
+            const int r0 = tid << 2;
+            const uint32_t s_addr = kv_sptr + static_cast<uint32_t>(KV_BF12_META_OFF_B + r0 * 4);
+            const void* g_ptr = &blk->meta[slot0 + r0];
+            if (use_l2_hint) kv_bf12_cp_async_cg_16_l2_hint(s_addr, g_ptr, l2_policy);
+            else             kv_bf12_cp_async_cg_16(s_addr, g_ptr);
+        }
+    } else {
+        auto row_bs = [&](int row) -> int2 {
+            const int kpos = n0_tile + row;
+            if (kpos >= s_end_live) return make_int2(-1, 0);
+            const int lblk = (BS_shift >= 0) ? (kpos >> BS_shift) : (kpos / BS);
+            const int slot = (BS_shift >= 0) ? (kpos & ((1 << BS_shift) - 1)) : (kpos % BS);
+            return make_int2(__ldg(bt_row + lblk), slot);
+        };
+        #pragma unroll
+        for (int i = 0; i < 4; ++i) {
+            const int idx = i * 128 + tid;
+            const int row = idx >> 3;
+            const int c   = idx & 7;
+            const int2 bs = row_bs(row);
+            if (bs.x >= 0) {
+                const KvBf12HalfBlock* blk = kv_bf12_half_blk_const(kv_half_base, blk_stride_bytes, bs.x);
+                const int swiz_c = kv_bf12_sm_stage_chunk(row, c);
+                const uint32_t s_addr = kv_sptr + static_cast<uint32_t>(KV_BF12_SM_OFF_B + row * 128 + swiz_c * 16);
+                const void* g_ptr = &blk->sm[bs.y][c * 16];
+                if (use_l2_hint) kv_bf12_cp_async_cg_16_l2_hint(s_addr, g_ptr, l2_policy);
+                else             kv_bf12_cp_async_cg_16(s_addr, g_ptr);
+            }
+        }
+        #pragma unroll
+        for (int i = 0; i < 2; ++i) {
+            const int idx = i * 128 + tid;
+            const int row = idx >> 2;
+            const int c   = idx & 3;
+            const int2 bs = row_bs(row);
+            if (bs.x >= 0) {
+                const KvBf12HalfBlock* blk = kv_bf12_half_blk_const(kv_half_base, blk_stride_bytes, bs.x);
+                const int swiz_c = kv_bf12_e4_stage_chunk(row, c);
+                const uint32_t s_addr = kv_sptr + static_cast<uint32_t>(KV_BF12_E4_OFF_B + row * 64 + swiz_c * 16);
+                const void* g_ptr = &blk->e4[bs.y][c * 16];
+                if (use_l2_hint) kv_bf12_cp_async_cg_16_l2_hint(s_addr, g_ptr, l2_policy);
+                else             kv_bf12_cp_async_cg_16(s_addr, g_ptr);
+            }
+        }
+        if (tid < KV_BF12_TILE_BN) {
+            reinterpret_cast<int32_t*>(smem_kv_u8 + KV_BF12_BLKID_OFF_B)[tid] = row_bs(tid).x;
+        }
+        if (tid < (KV_BF12_TILE_BN >> 2)) {
+            const int r0 = tid << 2;
+            const int2 b0 = row_bs(r0 + 0), b1 = row_bs(r0 + 1), b2 = row_bs(r0 + 2), b3 = row_bs(r0 + 3);
+            const bool contig4 =
+                (b0.x >= 0) && ((b0.y & 3) == 0) &&
+                (b1.x == b0.x) && (b1.y == b0.y + 1) &&
+                (b2.x == b0.x) && (b2.y == b0.y + 2) &&
+                (b3.x == b0.x) && (b3.y == b0.y + 3);
+            if (contig4) {
+                const KvBf12HalfBlock* blk = kv_bf12_half_blk_const(kv_half_base, blk_stride_bytes, b0.x);
+                const uint32_t s_addr = kv_sptr + static_cast<uint32_t>(KV_BF12_META_OFF_B + r0 * 4);
+                const void* g_ptr = &blk->meta[b0.y];
+                if (use_l2_hint) kv_bf12_cp_async_cg_16_l2_hint(s_addr, g_ptr, l2_policy);
+                else             kv_bf12_cp_async_cg_16(s_addr, g_ptr);
+            } else {
+                uint32_t* smem_meta = reinterpret_cast<uint32_t*>(smem_kv_u8 + KV_BF12_META_OFF_B);
+                auto load_meta_one = [&](int row_idx, int2 bk) {
+                    if (bk.x >= 0) {
+                        const KvBf12HalfBlock* blk = kv_bf12_half_blk_const(kv_half_base, blk_stride_bytes, bk.x);
+                        const uint32_t s_addr = kv_sptr + static_cast<uint32_t>(KV_BF12_META_OFF_B + row_idx * 4);
+                        kv_bf12_cp_async_ca_4(s_addr, &blk->meta[bk.y]);
+                    } else {
+                        smem_meta[row_idx] = 0u;
+                    }
+                };
+                load_meta_one(r0 + 0, b0);
+                load_meta_one(r0 + 1, b1);
+                load_meta_one(r0 + 2, b2);
+                load_meta_one(r0 + 3, b3);
+            }
+        }
+    }
+}
