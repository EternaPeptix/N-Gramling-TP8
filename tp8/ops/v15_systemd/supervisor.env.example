# Wave-V15 Supervisor Configuration Template -> Copy to /etc/inkling-v15/supervisor.env (chmod 0640)
# Parameterized host/user/path settings — ZERO hardcoded credentials or API secrets!

# 1. Cluster Topology & SSH Transport (ProxyJump for fabric-only nodes)
V15_HOSTS="spark-one spark-two spark-three spark-four spark-five spark-six spark-seven spark-eight"
V15_SSH_USER="REPLACE_WITH_CLUSTER_USER"
V15_SSH_JUMP_HOST="spark-one"
V15_SSH_JUMP_MAP="spark-five=10.77.0.51 spark-six=10.77.0.61"
V15_SSH_TIMEOUT="10"

# 2. Serving Endpoint & Launcher Paths
V15_HEAD_HOST="127.0.0.1"
PORT="8010"
V15_SERVED_MODEL="inkling-2-small"
V15_CONTAINER_PREFIX="inkling-tp8-r"
V15_REMOTE_LAUNCHER="/home/REPLACE_WITH_CLUSTER_USER/inkling-tp8/inkling-tp8-v15.sh"
V15_REMOTE_ENV_PATH="/tmp/inkling_v15_active.env"

# 3. Primary V15 Production Env + Verified V12 Fallback Env
V15_PRIMARY_ENV="/home/REPLACE_WITH_CLUSTER_USER/inkling-tp8/envs/v15_production.env"
V15_FALLBACK_ENV="/home/REPLACE_WITH_CLUSTER_USER/inkling-tp8/envs/live_champion_v12.env"

# 4. Logs, Persistent State & Recovery Lockfile
V15_LOG_DIR="/var/log/inkling-v15"
V15_STATE_DIR="/var/lib/inkling-v15"
V15_LOCK_FILE="/run/inkling-v15/recovery.lock"

# 5. Watchdog Cadence, UMA Guard & Circuit Breaker Thresholds
V15_WATCHDOG_INTERVAL_S="15"
V15_CANARY_INTERVAL_S="60"
V15_FAIL_THRESHOLD="2"
V15_REQUIRED_ACTIVE_HCAS="4"
V15_MAX_RESTARTS_15M="3"
V15_BREAKER_WINDOW_S="900"
V15_FALLBACK_AFTER_FAILS="2"
V15_STOP_TIMEOUT="30"
V15_STOP_ON_EXIT="0"

UMA_MIN_ORDER13_BLOCKS="2500"
UMA_MIN_ORDER_GE9_BLOCKS="2048"
UMA_MIN_ORDER_GE9_GIB="80"
UMA_MAX_SWAP_USED_MIB="256"
UMA_MIN_MEM_AVAIL_GIB="100"

# 6. Optional 1-Prompt 0-ULP Golden Digest Pin & Alert Hook (leave blank for repeat-determinism mode)
# V15_BOOT_CERT_SHA256=""
# V15_ALERT_CMD="/usr/local/bin/inkling-alert-hook.sh"
